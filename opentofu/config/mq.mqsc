* MQSC initialisation script.
* Executed once by the container runtime when the queue manager is created.
* Sets up:
*   - the app SVRCONN channel with mutual TLS
*   - the application principal "app" mapped from the client certificate
*   - APP.IN (queue alias) and APP.OUT (local queue)
*   - the Prometheus exporter service
*
* The application sends to APP.IN; APP.IN is an alias targeting APP.OUT;
* the application then reads back from APP.OUT - demonstrating that send
* and receive happen via different queue names.

* ---------------------------------------------------------------------------
* Authentication & authorisation
* ---------------------------------------------------------------------------

* Use the operating system / internal authorisation service rather than LDAP.
ALTER AUTHINFO(SYSTEM.DEFAULT.AUTHINFO.IDPWOS) AUTHTYPE(IDPWOS) +
  ADOPTCTX(YES) CHCKCLNT(OPTIONAL) CHCKLOCL(OPTIONAL) AUTHENMD(OS)
REFRESH SECURITY TYPE(CONNAUTH)

* ---------------------------------------------------------------------------
* Application channel
* ---------------------------------------------------------------------------

* SVRCONN that the application client connects to.
* SSLCAUTH(REQUIRED) forces the client to present its own certificate.
DEFINE CHANNEL(APP.SVRCONN) +
  CHLTYPE(SVRCONN) +
  TRPTYPE(TCP) +
  SSLCAUTH(REQUIRED) +
  SSLCIPH('ANY_TLS12_OR_HIGHER') +
  REPLACE

* Map a client whose certificate has CN=mq-client to the local user "app".
* This is how cert-based authentication is performed: the certificate
* presented during the TLS handshake controls the MCAUSER assigned to
* the connection.
SET CHLAUTH('APP.SVRCONN') +
  TYPE(SSLPEERMAP) +
  SSLPEER('CN=mq-client') +
  USERSRC(MAP) +
  MCAUSER('app') +
  ACTION(REPLACE)

* Block the catch-all rule that disallows administrative connections
* on this specific channel for the "app" user.
SET CHLAUTH('APP.SVRCONN') +
  TYPE(BLOCKUSER) +
  USERLIST('nobody') +
  ACTION(REPLACE)

* ---------------------------------------------------------------------------
* Queues
* ---------------------------------------------------------------------------

* The local queue we will eventually read messages from.
DEFINE QLOCAL('APP.OUT') +
  DESCR('Application receive queue') +
  DEFPSIST(YES) +
  MAXDEPTH(5000) +
  REPLACE

* The alias the application writes to. Writes are silently redirected
* to APP.OUT - showing the standard MQ pattern of decoupling the
* logical send target from the physical local queue.
DEFINE QALIAS('APP.IN') +
  DESCR('Application send queue (alias -> APP.OUT)') +
  TARGTYPE(QUEUE) +
  TARGET('APP.OUT') +
  DEFPSIST(YES) +
  PUT(ENABLED) +
  GET(ENABLED) +
  REPLACE

* ---------------------------------------------------------------------------
* Authorisations for the "app" principal
* ---------------------------------------------------------------------------

SET AUTHREC PRINCIPAL('app') OBJTYPE(QMGR) +
  AUTHADD(CONNECT,INQ)

SET AUTHREC PROFILE('APP.IN')  PRINCIPAL('app') OBJTYPE(QUEUE) +
  AUTHADD(PUT,INQ,BROWSE)
SET AUTHREC PROFILE('APP.OUT') PRINCIPAL('app') OBJTYPE(QUEUE) +
  AUTHADD(GET,INQ,BROWSE)

* ---------------------------------------------------------------------------
* Prometheus exporter service
* ---------------------------------------------------------------------------

ALTER QMGR MAXHANDS(512)

DEFINE SERVICE(MQPROMETHEUS) +
  CONTROL(QMGR) +
  SERVTYPE(SERVER) +
  STARTCMD('/usr/local/bin/mq_prometheus.sh') +
  STARTARG(+QMNAME+) +
  STOPCMD('/usr/bin/kill ') +
  STOPARG(+MQ_SERVER_PID+) +
  STDOUT('/var/mqm/errors/mq_prometheus.out') +
  STDERR('/var/mqm/errors/mq_prometheus.out') +
  DESCR('MQ exporter for Prometheus') +
  REPLACE
START SERVICE(MQPROMETHEUS)

* ---------------------------------------------------------------------------
* Dead-letter queue demonstration (publish/subscribe)
* ---------------------------------------------------------------------------
* A failing local MQPUT just returns a reason code to the application - the
* message is NOT dead-lettered. Dead-lettering happens when the QUEUE MANAGER
* (or a channel MCA) cannot deliver a message to its destination queue.
*
* On a single queue manager the simplest way to trigger that is publish/
* subscribe: when a publication cannot be delivered to a subscriber's queue,
* and the topic has USEDLQ(YES), the queue manager moves it to the DLQ.
*
*   amqsput DLQ.TEST (QALIAS -> TOPIC dlq/demo)
*        -> queue manager tries to deliver the publication to DLQ.SUB's
*           destination queue DLQ.TARGET, which is PUT(DISABLED)
*        -> delivery fails, so the message goes to DEAD.LETTER.QUEUE with an
*           MQDLH header carrying reason 2051 (MQRC_PUT_INHIBITED).
*
* Verify with:   amqsbcg DEAD.LETTER.QUEUE qm1
* and look for  Reason : 2051  and  DestQName : DLQ.TARGET  in the header.
*
* NOTE: a sender/receiver "loopback" on one queue manager does NOT work -
* the sender requests its own channel name at the partner, and a channel
* name is unique per QM, so the inbound connection can never find a receiver.

* The dead-letter queue, and point the queue manager at it.
DEFINE QLOCAL('DEAD.LETTER.QUEUE') +
  DESCR('Dead-letter queue') +
  MAXDEPTH(5000) +
  REPLACE
ALTER QMGR DEADQ('DEAD.LETTER.QUEUE')

* The subscriber's destination queue - deliberately put-disabled so that
* every publication delivered to it fails and is dead-lettered.
DEFINE QLOCAL('DLQ.TARGET') +
  DESCR('Subscriber queue, put-disabled on purpose') +
  PUT(DISABLED) +
  REPLACE

* The topic. USEDLQ(YES) tells the QM to dead-letter publications that
* cannot be delivered to a subscriber (rather than discarding them).
DEFINE TOPIC('DLQ.TOPIC') +
  DESCR('Topic for the dead-letter demo') +
  TOPICSTR('dlq/demo') +
  USEDLQ(YES) +
  REPLACE

* A durable, administratively-defined subscription whose destination is the
* put-disabled queue. It exists without any subscribing application, so a
* single publish is enough to trigger the undeliverable-message path.
DEFINE SUB('DLQ.SUB') +
  DESCR('Subscription pointing at the put-disabled queue') +
  TOPICSTR('dlq/demo') +
  DEST('DLQ.TARGET') +
  REPLACE

* The queue name the application puts to. It is an alias over the topic,
* so an ordinary MQPUT (e.g. amqsput) becomes a publish.
DEFINE QALIAS('DLQ.TEST') +
  DESCR('Alias over DLQ.TOPIC - putting here publishes to dlq/demo') +
  TARGET('DLQ.TOPIC') +
  TARGTYPE(TOPIC) +
  REPLACE

* Let the "app" principal publish to the topic (needed when driving the
* demo from the client pod; not required when running amqsput on the QM pod).
SET AUTHREC PROFILE('DLQ.TOPIC') PRINCIPAL('app') OBJTYPE(TOPIC) +
  AUTHADD(PUB)

REFRESH SECURITY TYPE(CONNAUTH)
